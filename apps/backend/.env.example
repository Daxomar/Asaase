# Copy to .env (git-ignored) and adjust as needed.

# Single DSN takes priority over the PG* parts below.
DATABASE_URL=postgresql://asaase:asaase@localhost:5432/asaase

# Used only if DATABASE_URL is unset — matches docker-compose.yml defaults.
PGHOST=localhost
PGPORT=5432
PGUSER=asaase
PGPASSWORD=asaase
PGDATABASE=asaase

PORT=3001

# AI provider switcher (ORCHESTRATOR_CONTRACT.md §4) — dev uses local Ollama unconditionally;
# these only matter once NODE_ENV=production.
NODE_ENV=development
OLLAMA_BASE_URL=http://localhost:11434/v1
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_VISION_MODEL=gpt-4o-mini
AI_TEXT_MODEL=gpt-4o-mini
